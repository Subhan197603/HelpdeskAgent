{
  "name": "fusion-ai-helpdesk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "openapi:client": "openapi-typescript docs/api/openapi.json -o packages/api-client/src/generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/scaffold.test.ts && pnpm --filter @fusion-helpdesk/web test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
